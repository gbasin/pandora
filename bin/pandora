#!/bin/sh
# `pandora`: resolve the package next to this script and hand over.
#
# The script is usually reached through a symlink (`~/.local/bin/pandora` ->
# `<checkout>/bin/pandora`), so "next to this script" means next to the file the
# chain of links ends at, not next to the link. Without this, PYTHONPATH became
# `~/.local` and `pandora ps` worked only when the cwd happened to be a checkout,
# because `python -m` puts the cwd on sys.path. `readlink -f` is not on every
# macOS, so the chain is walked one `readlink` at a time, relative targets
# resolved against the link's own directory, and bounded in case of a loop.
self=$0
case $self in */*) ;; *) self=./$self ;; esac
hops=0
while [ -L "$self" ] && [ "$hops" -lt 40 ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *) self=${self%/*}/$link ;;
    esac
    hops=$((hops + 1))
done
selfdir=${self%/*}
home=${PANDORA_HOME:-$selfdir/..}
# The physical directory: after `pandora upgrade` the script sits under the
# `current` symlink, which the next upgrade flips, and a daemon that imports a
# module hours later must find it in the version it started from.
if physical=$(CDPATH='' cd -P -- "$home" 2>/dev/null && pwd); then home=$physical; fi
PYTHONPATH=$home${PYTHONPATH:+:$PYTHONPATH}
export PYTHONPATH
# `python -m` puts the cwd ahead of PYTHONPATH, so a `pandora` typed inside a
# checkout ran that checkout's code. `boot` is `-m` without the cwd: `-c` puts
# "" first, which it drops, then runs the module as `-m` would. Not `-P`: a
# 3.9 `python3` rejects the flag, and the shim's logger must run on one.
boot='import runpy, sys; sys.path[:1] == [""] and sys.path.pop(0); del sys.argv[0]; runpy._run_module_as_main(sys.argv[0])'
exec "${PANDORA_PYTHON:-python3}" -B -c "$boot" pandora.cli "$@"
