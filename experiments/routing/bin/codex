#!/usr/bin/env python3
"""Session-only Codex config: preserve routing in shell tools."""
import json
import os
import sys

real = os.environ['PANDORA_REAL_CODEX']
args = [real, '-c', 'allow_login_shell=false']
for key in ['PATH', 'PANDORA_HOST', 'PANDORA_STATE', 'PANDORA_SESSION',
            'PANDORA_REAL_PNPM', 'PANDORA_REAL_CODEX']:
    args += ['-c', 'shell_environment_policy.set.' + key + '=' + json.dumps(os.environ[key])]
os.execv(real, [*args, *sys.argv[1:]])
