#!/usr/bin/env python3
"""Session-only Codex config: preserve routing in shell tools."""
import json
import os
from pathlib import Path
import sys

real = os.environ['PANDORA_REAL_CODEX']
# Add the dedicated transport state alongside existing writable roots. Do not
# replace the user's sandbox configuration or disable it to support routing.
overrides = ['--add-dir', os.environ['PANDORA_STATE']]
os.environ['PATH'] = str(Path(__file__).resolve().parent) + os.pathsep + os.environ['PATH']
for key in ['PANDORA_HOST', 'PANDORA_STATE', 'PANDORA_SESSION',
            'PANDORA_REAL_PNPM', 'PANDORA_REAL_CODEX', 'PANDORA_TREATMENT', 'PANDORA_QUEUE_TIMEOUT_SECONDS', 'ZDOTDIR', 'PANDORA_ORIGINAL_ZDOTDIR']:
    overrides += ['-c', 'shell_environment_policy.set.' + key + '=' + json.dumps(os.environ[key])]
if 'PANDORA_DOCKER_PROFILE_JSON' in os.environ:
    overrides += ['-c', 'shell_environment_policy.set.PANDORA_DOCKER_PROFILE_JSON=' + json.dumps(os.environ['PANDORA_DOCKER_PROFILE_JSON'])]
command = sys.argv[1:]
if command[:1] == ['exec']:
    command = ['exec', *overrides, *command[1:]]
else:
    command = [*overrides, *command]
os.execv(real, [real, *command])
